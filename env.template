# Template for .env file

# Configuration Supabase
SUPABASE_URL=https://your-project-name.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_USERS_TABLE=users

# Configuration Casdoor
CASDOOR_ENDPOINT=https://your-casdoor-endpoint.com
CASDOOR_CLIENT_ID=your-casdoor-client-id
CASDOOR_CLIENT_SECRET=your-casdoor-client-secret
CASDOOR_ORGANIZATION=your-organization-name
CASDOOR_APPLICATION=your-application-name

# Configuration Mattermost
MATTERMOST_URL=https://your-mattermost-server.com
MATTERMOST_TOKEN=your-mattermost-api-token

# Configuration Postfix
POSTFIX_SERVER=mail.example.com
POSTFIX_ADMIN_USER=admin
POSTFIX_ADMIN_PASSWORD=your-secure-password

# Configuration OwnCloud
OWNCLOUD_URL=https://your-owncloud-instance.com
OWNCLOUD_ADMIN_USER=admin
OWNCLOUD_ADMIN_PASSWORD=your-secure-password

# Configuration de logging
LOG_LEVEL=INFO